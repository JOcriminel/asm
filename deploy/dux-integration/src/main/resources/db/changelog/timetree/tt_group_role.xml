<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="tt-group-role-001" author="architect">
        <createTable tableName="TT_GROUP_ROLE" schemaName="dbo">
            <column name="GROUP_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ROLE_CODE" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="TT_GROUP_ROLE" schemaName="dbo" columnNames="GROUP_ID, ROLE_CODE" constraintName="PK_TT_GROUP_ROLE"/>
    </changeSet>
</databaseChangeLog>
