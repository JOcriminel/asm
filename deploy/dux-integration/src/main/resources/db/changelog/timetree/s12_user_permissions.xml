<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="tt-member-permissions-001" author="antigravity">
        <addColumn tableName="TT_MEMBER" schemaName="dbo">
            <column name="CAN_CREATE_AGENDAS" type="BIT" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="CAN_ADD_MEMBERS" type="BIT" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="PROFILE_PICTURE" type="CLOB"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
