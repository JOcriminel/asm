<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-document-validation-proof-table" author="antigravity">
        <createTable tableName="document_validation_proof" schemaName="dbo">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="document_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="document_type" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="signature_path" type="VARCHAR(500)"/>
            <column name="photo_path" type="VARCHAR(500)"/>
            <column name="validated_by" type="VARCHAR(100)"/>
            <column name="validated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="document_validation_proof" indexName="idx_doc_val_proof" schemaName="dbo">
            <column name="document_id"/>
            <column name="document_type"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
