<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="tt-page-001" author="architect">
        <createTable tableName="TT_PAGE" schemaName="dbo">
            <column name="ID" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CATEGORY_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(150)"/>
            <column name="ROUTE" type="VARCHAR(250)"/>
            <column name="ICON" type="VARCHAR(100)"/>
            <column name="COMPONENT_NAME" type="VARCHAR(150)"/>
            <column name="DISPLAY_ORDER" type="INT"/>
            <column name="ACTIVE" type="BIT" defaultValueBoolean="true"/>
            <column name="CREATED_AT" type="DATETIME2"/>
            <column name="UPDATED_AT" type="DATETIME2"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="TT_PAGE" baseColumnNames="CATEGORY_ID"
                                 referencedTableName="TT_CATEGORY" referencedColumnNames="ID"
                                 constraintName="FK_PAGE_CATEGORY"/>
    </changeSet>
</databaseChangeLog>
